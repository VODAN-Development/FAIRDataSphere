# Backend
NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://your-frontend-domain.example
COOKIE_SECURE=true

# Public domains used by Caddy
APP_DOMAIN=your-frontend-domain.example
API_DOMAIN=your-backend-domain.example

# AllegroGraph
ALLEGRO_BASE_URL=http://allegrograph:10035
ALLEGRO_CATALOG=/
ALLEGRO_REPOSITORY=sitrep
ALLEGRO_USERNAME=admin
ALLEGRO_PASSWORD=

# Auth and encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Must be base64, not base64url. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Frontend
VITE_GRAPHQL_URL=https://your-backend-domain.example/graphql
