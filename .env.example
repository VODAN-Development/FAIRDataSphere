# Full-stack Docker/production environment.
#
# Copy this file to .env at the repository root when running docker compose.

# Backend
NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://your-frontend-domain.example
COOKIE_SECURE=true

# Public domains used by Caddy
APP_DOMAIN=your-frontend-domain.example
API_DOMAIN=your-backend-domain.example
AGRAPH_DOMAIN=your-allegrograph-domain.example

# AllegroGraph
ALLEGRO_BASE_URL=http://allegrograph:10035
ALLEGRO_CATALOG=/
ALLEGRO_REPOSITORY=sitrep
ALLEGRO_USERNAME=admin
ALLEGRO_PASSWORD=

# Auth and encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Turnstile signup protection. Store the real secret only in this backend env.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=fairdatasphere.com

# Must be base64, not base64url. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Generate separate base64 keys with the same command for these credentials.
REPOSITORY_PASSWORD_ENCRYPTION_KEY=
JOIN_PASSWORD_ENCRYPTION_KEY=

# SMTP settings for one-time signup codes.
APP_NAME=FAIR Data Sphere
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_FROM="FAIRDataSphere <no-reply@fairdatasphere.com>"

# Frontend
VITE_GRAPHQL_URL=https://your-backend-domain.example/graphql
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEeEXKtO-6WeBaTo
