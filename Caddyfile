# Public frontend domain serves the built React app.
{$APP_DOMAIN} {
    reverse_proxy frontend:80
}

# API domain forwards browser GraphQL requests to the Express/Apollo backend.
{$API_DOMAIN} {
    reverse_proxy backend:4000
}

# AllegroGraph gets its own domain for administrative access when exposed.
{$AGRAPH_DOMAIN} {
    reverse_proxy https://allegrograph:10036 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        transport http {
            tls_trusted_ca_certs /etc/caddy/certs/agraph-ca.crt
        }
    }
}

# Keycloak identity provider for SSO/OIDC.
{$KEYCLOAK_DOMAIN} {
    reverse_proxy keycloak:8080 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }
}
