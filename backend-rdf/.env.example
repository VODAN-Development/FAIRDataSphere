# Backend-only environment for running backend-rdf directly with
# `npm start`. Docker Compose normally uses the root .env instead.

NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://your-frontend-domain.example
COOKIE_SECURE=true

# AllegroGraph
ALLEGRO_BASE_URL=https://your-allegrograph-host.example
ALLEGRO_CATALOG=/
ALLEGRO_REPOSITORY=sitrep
ALLEGRO_USERNAME=
ALLEGRO_PASSWORD=

# Auth and encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Turnstile signup protection. Store the real secret only in your backend env.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# Must be base64, not base64url. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Generate separate base64 keys with the same command for these credentials.
REPOSITORY_PASSWORD_ENCRYPTION_KEY=
JOIN_PASSWORD_ENCRYPTION_KEY=

# SMTP settings for one-time signup codes.
APP_NAME=
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_FROM="name <no-reply@name.com>"
