# AllegroGraph configuration file for FAIR Data Sphere.
#
# Keep idle repository instances open briefly for responsive navigation, then
# let AllegroGraph release their shared-memory segments on low-traffic systems.
RunAs agraph
SessionPorts 10000-10034
Port 10035
AllowHTTP no
SSLPort 10036
SSLCertificate /agraph/certs/server-cert-and-key.pem
RedirectHTTPOnHTTPS yes
SettingsDirectory /agraph/data/settings
LogDir /agraph/data
PidFile /agraph/data/agraph.pid
InstanceTimeout 5m

<RootCatalog>
  Main /agraph/data/rootcatalog
  InstanceTimeout 5m
</RootCatalog>

<SystemCatalog>
  Main /agraph/data/systemcatalog
  InstanceTimeout 10s
</SystemCatalog>

AuthPolicy internal-external

OAuth server="https://auth.fairdatasphere.com/realms/fairdatasphere", \
  authorize-endpoint="/protocol/openid-connect/auth", \
  token-endpoint="/protocol/openid-connect/token", \
  jwks-uri="https://auth.fairdatasphere.com/realms/fairdatasphere/protocol/openid-connect/certs", \
  jws-algorithms="RS256", \
  client-id="fds-agraph", \
  client-secret="", \
  scope="openid email profile", \
  username-claim="preferred_username", \
  pkce=yes, \
  front-channel-logout=yes, \
  back-channel-logout=yes

#OAuth server="https://auth.humanitariandataspace.com/realms/hds", \
#  authorize-endpoint="/protocol/openid-connect/auth", \
#  token-endpoint="/protocol/openid-connect/token", \
